# Template for reference only. Real files are gitignored:
#   .env.development  → local Mac run (uvicorn + localhost Postgres)
#   .env.production   → Lightsail server (created there manually)
# The app picks the file via DIRECTHOME_APP_ENV.

# ---- required ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=directhome

DIRECTHOME_DATABASE_URL=postgresql+psycopg://postgres:change-me-strong-password@db:5432/directhome
DIRECTHOME_SECRET_KEY=generate-a-long-random-string
DIRECTHOME_APP_ENV=production

# comma-separated origins allowed to call the API (your Vercel frontend etc.)
DIRECTHOME_CORS_ORIGINS=https://directhome-jet.vercel.app,http://localhost:3000

# API hostname for automatic HTTPS — e.g. api.directhome.in
# leave empty for HTTP-only on the instance IP
DOMAIN=

# optional: uvicorn worker processes (default 2, matches 2 vCPUs)
# UVICORN_WORKERS=2

# ---- later: S3 presigned uploads ----
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=directhome-media
